# Copy this file to .env for local development, then adjust values as needed.

POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=civicwatch_explore
POSTGRES_USER=postgres
DATABASE_URL=postgres://postgres@localhost:55432/civicwatch_explore
CIVICWATCH_START_LOCAL_POSTGRES=auto

# Production-compatible database aliases are also supported by the Bash launcher
# and API. If DB_PASSWORD contains URI-special characters, prefer DATABASE_URL.
# If you use DB_* in production, remove or comment out the local DATABASE_URL.
# DB_HOST=picso102.sci.pitt.edu
# DB_PORT=5432
# DB_NAME=civicwatch
# DB_USER=civicwatch
# DB_PASSWORD=replace-me
# DB_SSL=require

API_HOST=127.0.0.1
API_PORT=4000
# PORT is accepted as an API_PORT alias for prototype-style deployments.
# PORT=4000
API_BASE_URL=http://127.0.0.1:4000/api/v1
PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
PUBLIC_BASE_PATH=

# API traffic controls. In production behind the Express proxy, keep
# CIVICWATCH_TRUST_PROXY=true and enable xfwd: true in http-proxy-middleware so
# browser API calls are keyed by the real client IP rather than 127.0.0.1.
CIVICWATCH_TRUST_PROXY=true
CIVICWATCH_RATE_LIMIT_MAX=900
CIVICWATCH_RATE_LIMIT_WINDOW=1 minute
CIVICWATCH_RATE_LIMIT_BYPASS_INTERNAL=true
CIVICWATCH_META_CACHE_SECONDS=300
CIVICWATCH_BODY_LIMIT_BYTES=262144
CIVICWATCH_CORS_ENABLED=true
# In production, prefer disabling open CORS or naming allowed origins exactly.
# CIVICWATCH_CORS_ENABLED=false
# CIVICWATCH_CORS_ORIGINS=https://picso101.sci.pitt.edu
CIVICWATCH_API_DOCS_ENABLED=true
CIVICWATCH_ANALYTICS_ENABLED=true
CIVICWATCH_ANALYTICS_FILE=logs/analytics.jsonl
CIVICWATCH_ANALYTICS_RATE_LIMIT_MAX=120
CIVICWATCH_ANALYTICS_RATE_LIMIT_WINDOW=1 minute
# Optional but recommended in production. Set the same private value for the
# SvelteKit web process and Fastify API process.
# CIVICWATCH_INTERNAL_TOKEN=replace-with-long-random-secret

# Express proxy edge controls, used by server.civicwatch.example.js.
CIVICWATCH_EDGE_RATE_LIMIT_MAX=600
CIVICWATCH_EDGE_RATE_LIMIT_WINDOW_MS=60000

# Used by scripts/start-civicwatch.sh --production.
WEB_HOST=127.0.0.1
WEB_PORT=3000
